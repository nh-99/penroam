{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Penroam",
  "version": "0.1.0-beta.10",
  "identifier": "ink.penroam.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Penroam", "width": 1280, "height": 900, "minWidth": 360, "minHeight": 480, "resizable": true }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "dmg", "app"],
    "category": "Productivity",
    "shortDescription": "Handwriting notebook",
    "publisher": "Penroam contributors",
    "license": "MPL-2.0",
    "homepage": "https://penroam.ink",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "android": { "minSdkVersion": 26 },
    "iOS": { "minimumSystemVersion": "16.0" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2ODU3RUVDMTIwM0ZBMzMKUldReitnTVM3SDZGNXJNWHBDREdPKzQyMjR1UXc4c0JGM2h3RkpCNUhLVHJWSE9KNXk5VThYc2QK",
      "requireSignedVersion": true,
      "endpoints": ["https://github.com/nh-99/penroam/releases/download/updates-stable/latest.json"]
    },
    "deep-link": {
      "mobile": [{ "scheme": ["ink.penroam.app"], "appLink": false }]
    }
  }
}
