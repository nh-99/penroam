{
  "name": "penroam-workspace",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --filter penroam dev",
    "build": "pnpm --filter penroam build",
    "test": "pnpm --filter penroam test",
    "typecheck": "pnpm --filter penroam typecheck",
    "lint": "pnpm --filter penroam lint",
    "tauri": "pnpm --filter penroam tauri",
    "fixtures": "node tests/fixtures/generate-fixtures.mjs",
    "fixtures:check": "node tests/fixtures/generate-fixtures.mjs --check"
  }
}
